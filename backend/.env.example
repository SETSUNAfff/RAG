ASYNC_DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/rag
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_TOKEN_BUDGET=4000
DEEPSEEK_API_KEY=your-key-here
